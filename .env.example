# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
UNITRENDS_BASE_URL=
UNITRENDS_USERNAME=
UNITRENDS_PASSWORD=
# 'false' for self-signed appliances. Not a credential.
UNITRENDS_VERIFY_TLS=true

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address when MCP_TRANSPORT=http. A configured CONDUIT_S2S_SECRET
# honors MCP_HTTP_HOST and defaults to 0.0.0.0 when this is unset, so
# container deploys stay on every interface. The container image sets
# 0.0.0.0. Without a secret, MCP_ALLOW_INSECURE_DEV=1 binds 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (changeme,
# change-me, placeholder, secret, example, your-s2s-secret, your-secret,
# replace-me, replace-with-a-real-secret, s2s-secret), so a copied example
# cannot forge X-Gateway-S2S. docker compose will not start if it is unset
# or empty. Never commit a real secret. The value is never logged. A known
# placeholder is refused even when MCP_ALLOW_INSECURE_DEV=1; unset the
# secret to use that local-only bypass.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. Logs a warning, does not check X-Gateway-S2S, and
# binds 127.0.0.1 only. A non-loopback MCP_HTTP_HOST (including 0.0.0.0)
# is overridden and the override is logged.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Unitrends-Base-URL, X-Unitrends-Username, and X-Unitrends-Password
# headers; no env fallback). The container image defaults to env. Compose
# sets gateway. Stdio ignores this and reads UNITRENDS_* from the environment.
# AUTH_MODE=env

LOG_LEVEL=info
